# PennyWise Backend

# SQLite database file path
DATABASE_URL="file:./dev.db"

# JWT secret for token signing (change in production!)
JWT_SECRET="change-this-to-a-strong-random-secret"

# Groq API key for AI features (get one free at https://console.groq.com)
# Leave blank to disable AI features
GROQ_API_KEY=""

# Server port
PORT=3000

# Comma-separated CORS origins (for production, set your deployed frontend URL)
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:4173"
