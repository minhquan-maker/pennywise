# PennyWise Backend

# PostgreSQL. Locally: `docker compose up -d db` (see docker-compose.yml).
# On Vercel the Neon integration sets both automatically (pooled + direct).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pennywise"
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/pennywise"

# JWT secret for token signing (change in production!)
JWT_SECRET="change-this-to-a-strong-random-secret"

# Groq API key for AI features (get one free at https://console.groq.com)
# Leave blank to disable AI features
GROQ_API_KEY=""

# Server port
PORT=3000

# Comma-separated CORS origins (for production, set your deployed frontend URL)
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:4173"

# Optional: forward contact-form messages to a Slack or Discord incoming webhook
CONTACT_WEBHOOK_URL=""
