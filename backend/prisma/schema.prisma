// This is your Prisma schema file
generator client {
  provider      = "prisma-client-js"
  // native for local/Docker, rhel-openssl-3.0.x for Vercel's Node runtime
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Pooled connection for queries; direct connection for migrations (Neon on Vercel sets both)
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  isDemo       Boolean  @default(false)
  currency     String   @default("USD")
  createdAt    DateTime @default(now())

  transactions Transaction[]
  categories   Category[]
  budgets      Budget[]
}

model Category {
  id        String  @id @default(cuid())
  userId    String
  name      String
  icon      String  @default("$")
  color     String  @default("#6366f1")
  type      String  @default("expense") // "expense" | "income"
  isDefault Boolean @default(false)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]
}

model Transaction {
  id         String   @id @default(cuid())
  userId     String
  categoryId String
  amount     Float
  type       String   @default("expense") // "expense" | "income"
  note       String?
  date       DateTime
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model Budget {
  id         String @id @default(cuid())
  userId     String
  categoryId String
  amount     Float
  month      String // "YYYY-MM"

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, month])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  topic     String   @default("general")
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}
